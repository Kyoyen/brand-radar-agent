# Brand Radar 本地企划桌面
# 复制到 .env 后填写；已有 .env 时不要覆盖。
# 页面可以在未配置 Key 时打开，调查与改稿只使用真实模型。

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=

# 其他已接入服务：同时修改 LLM_PROVIDER、LLM_MODEL 与对应 Key。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPUAI_API_KEY=

# 旧 --weekly Replay 入口保留兼容；新桌面不使用 Mock 或外发工具。
