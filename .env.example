# ============================================================
# Brand Radar Agent — 环境变量配置
# 用法：cp .env.example .env  然后填入真实值
# 注意：完全不填会进入 MockProvider 烟雾测试；第一版业务验收必须配置真实 Key
# ============================================================

# ── LLM 配置 ────────────────────────────────────────────────────
# 默认示例：DeepSeek。也可按下方变量切换其他已支持的平台

LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# 切换其他平台：注释掉上面 3 行，取消下方对应组的注释

# OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=

# 月之暗面 Moonshot
# LLM_PROVIDER=moonshot
# LLM_MODEL=moonshot-v1-8k
# MOONSHOT_API_KEY=

# 智谱 GLM（有免费额度）
# LLM_PROVIDER=zhipu
# LLM_MODEL=glm-4-flash
# ZHIPU_API_KEY=

# ── 业务配置 ────────────────────────────────────────────────────

TARGET_BRAND=瑞幸咖啡
COMPETITOR_BRANDS=星巴克中国,库迪咖啡,Manner,麦咖啡
# 早期变量，第一版 Replay / 人工材料流程不使用，也不代表需要抓取这些平台
MONITOR_PLATFORMS=小红书,抖音,微博

# ── 早期推送配置（不属于第一版默认流程）─────────────────────────
# 第一版不得自动外发。飞书机器人 Webhook 保持为空；仅在人工明确确认后单独测试
# 获取：飞书群 → 设置 → 群机器人 → 添加自定义机器人

FEISHU_WEBHOOK_URL=

# ── 高级配置（一般不动）─────────────────────────────────────────

AGENT_MAX_TURNS=12
AGENT_CHECKPOINT_EVERY=5
DEBUG=false
